import matplotlib.pyplot as plt
from astropy.io import fits

## Opens the FITS file from its folder
filepath1 = '~/path/to/calib/median_bias.fit'
with fits.open(filepath1) as hdul:
    bias_data = hdul[0].data  # Get the image pixel array

