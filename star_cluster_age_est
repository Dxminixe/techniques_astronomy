with fits.open(filepath1) as hdul:
    bias_data = hdul[0].data  # Get the image pixel array
    
filepath2 = 'demo_data/calib/median_dark.fit'
with fits.open(filepath2) as hdul:
    dark_data = hdul[0].data  # Get the image pixel array

filepath3 = 'demo_data/calib/median_flat.fit'
with fits.open(filepath3) as hdul:
    flat_data = hdul[0].data  # Get the image pixel array

